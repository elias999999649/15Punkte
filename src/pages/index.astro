---
import App from '../components/App';
import '../styles/global.css';
import { BADEN_WUERTTEMBERG_RULES, BW_ABITUR_2028_RULES } from '../lib/states/baden-wuerttemberg';
const websiteUrl = 'https://15pkt.pages.dev';
const structuredData = {
  '@context': 'https://schema.org',
  '@type': 'SoftwareApplication',
  name: '15Punkte',
  applicationCategory: 'EducationalApplication',
  operatingSystem: 'Web',
  url: websiteUrl,
  inLanguage: 'de-DE',
  description: 'Kostenloser Notenmanager fürs Abi: Oberstufen-Noten, Fächer, Halbjahresschnitte und Abitur 2028 für Baden-Württemberg – lokal im Gastmodus oder synchronisiert mit Google-Konto.',
  featureList: ['Oberstufen-Noten und Fächer verwalten', 'Noten nach Halbjahr eintragen', 'Fachschnitte und Notendurchschnitt berechnen', 'Abitur-Gesamtqualifikation aus Block I und Block II berechnen', 'Offizielle Regelquellen für Baden-Württemberg', 'Lokaler JSON-Export und Import', 'Optionale Google-Anmeldung und Cloud-Synchronisierung'],
  offers: { '@type': 'Offer', price: '0', priceCurrency: 'EUR' },
};
const aboutSchema = {
  '@context': 'https://schema.org',
  '@type': 'WebPage',
  name: 'Abiturregeln Baden-Württemberg',
  about: 'Gymnasiale Oberstufe und Abiturjahrgang 2028',
  url: `${websiteUrl}/#regeln`,
  dateModified: BW_ABITUR_2028_RULES.sourceCheckedOn,
  citation: [...BADEN_WUERTTEMBERG_RULES.sources, ...BW_ABITUR_2028_RULES.sources].map((source) => source.url),
};
const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: [
    { '@type': 'Question', name: 'Wo speichert 15Punkte meine Noten?', acceptedAnswer: { '@type': 'Answer', text: 'Ohne Anmeldung bleiben Fächer, Leistungen, Ziele und Einstellungen lokal in deinem Browser. Wenn du dich mit Google anmeldest, wird dein Notenbuch in Firestore gespeichert und ist durch Regeln auf dein eigenes Konto beschränkt. Ein JSON-Export bleibt verfügbar.' } },
    { '@type': 'Question', name: 'Wie funktioniert der Abiturrechner?', acceptedAnswer: { '@type': 'Answer', text: 'Der Abiturrechner fasst Kursleistungen aus Block I und Prüfungsergebnisse aus Block II zusammen. Er dient der persönlichen Orientierung; verbindliche Vorgaben und Ergebnisse bestätigt die Schule.' } },
    { '@type': 'Question', name: 'Für welchen Abiturjahrgang gelten die hinterlegten Quellen?', acceptedAnswer: { '@type': 'Answer', text: 'Das dokumentierte Regelmodul bezieht sich auf das allgemeinbildende Gymnasium in Baden-Württemberg und den Abiturjahrgang 2028. Andere Jahrgänge können abweichende Vorgaben haben.' } },
  ],
};
const jsonLd = (schema: object) => JSON.stringify(schema).replace(/</g, '\\u003c');

const title = 'Notenmanager fürs Abi – Noten & Fächer im Blick | 15Punkte';
const description = 'Mit dem kostenlosen Notenmanager 15Punkte verwaltest du Oberstufen-Noten und Fächer, vergleichst Halbjahre und berechnest deine Abitur-Gesamtqualifikation für Baden-Württemberg.';
---
<!doctype html>
<html lang="de">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="google-site-verification" content="rylsW5TzohyKjKDfX8PxnMCWazZkitUeJoBjVg65Ayw" />
    <meta name="theme-color" content="#f7f8fa" />
    <meta name="description" content={description} />
    <meta name="robots" content="index, follow, max-image-preview:large" />
    <meta property="og:locale" content="de_DE" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="15Punkte" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={websiteUrl} />
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <link rel="canonical" href={`${websiteUrl}/`} />
    <script type="application/ld+json" set:html={jsonLd(structuredData)} />
    <script type="application/ld+json" set:html={jsonLd(aboutSchema)} />
    <script type="application/ld+json" set:html={jsonLd(faqSchema)} />
    <link rel="icon" type="image/jpeg" href="/faviconandlogo.jpg" />
    <link rel="shortcut icon" href="/faviconandlogo.jpg" />
    <link rel="apple-touch-icon" href="/faviconandlogo.jpg" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <meta property="og:image" content={`${websiteUrl}/faviconandlogo.jpg`} />
    <meta property="og:image:type" content="image/jpeg" />
    <meta name="twitter:image" content={`${websiteUrl}/faviconandlogo.jpg`} />
    <link rel="preload" href="/fonts/GoogleSansFlex-Regular.ttf" as="font" type="font/ttf" crossorigin />
    <title>{title}</title>
  </head>
  <body>
    <App client:load />
  </body>
</html>
